# Use an official Node image to run the dev environment
FROM node:20-slim

# Set the working directory inside the container
WORKDIR /app

# Copy package files first
COPY package*.json .

# Install your React dependencies
RUN npm install

# Copy the rest of your frontend code
COPY . .

# Expose the port your React app runs on (Vite defaults to 5173, Create-React-App to 3000)
EXPOSE 5173

# Command to launch the development server
CMD ["npm", "run", "dev", "--", "--host"]
